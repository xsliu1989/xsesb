        <dependency>
            <groupId>com.xs</groupId>
            <artifactId>xrpc-common-crud</artifactId>
            <version>1.0-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>com.xs</groupId>
            <artifactId>xrpc-common-cache-datastructure</artifactId>
            <version>1.0-SNAPSHOT</version>
